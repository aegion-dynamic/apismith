# Optional overlays applied to the default (dev) environment.
# Copy to .env and fill in. Never commit real secrets.

CONSOLE_LISTEN=127.0.0.1:8090
CONSOLE_OPENAPI_SPEC=openapi/openapi.yaml
CONSOLE_DEFAULT_ENV=dev

# Target API (local or hosted). Overlays the default environment's base_url.
CONSOLE_BASE_URL=http://localhost:8080/api/v1
# CONSOLE_BASE_URL=https://your-hosted-api.example.com/api/v1

# Cognito (same variables the backend uses)
AWS_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
# Optional: cognito-local emulator
# COGNITO_ENDPOINT=http://localhost:9229
# CONSOLE_AUTH_FLOW=srp   # srp | password

# Used by Generate JWT when the UI does not supply username/password
CONSOLE_USERNAME=
CONSOLE_PASSWORD=
